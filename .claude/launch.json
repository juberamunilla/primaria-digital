{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "primaria-digital",
      "runtimeExecutable": "node",
      "runtimeArgs": ["-e", "const h=require('http'),f=require('fs'),p=require('path');const t={'.html':'text/html; charset=utf-8','.js':'text/javascript; charset=utf-8','.css':'text/css','.ttf':'font/ttf'};h.createServer((q,r)=>{let u=decodeURIComponent(q.url.split('?')[0]);if(u.endsWith('/'))u+='index.html';const a=p.join(process.cwd(),u);f.readFile(a,(e,d)=>{if(e){r.writeHead(404);return r.end();}r.writeHead(200,{'Content-Type':t[p.extname(a).toLowerCase()]||'application/octet-stream'});r.end(d);});}).listen(8765)"],
      "port": 8765
    }
  ]
}
